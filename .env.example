# ===========================================
# FastAPI Boilerplate - Environment Variables
# ===========================================
# Copy this file to .env and update the values
# for your environment.

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fastapi-boilerplate

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===========================================
# Security Configuration
# IMPORTANT: Change these in production!
# ===========================================
JWT_SECRET=change-me-to-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800
VERIFICATION_CODE_EXPIRE_SECONDS=300

# ===========================================
# Email (Resend)
# ===========================================
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ===========================================
# Invitation Code
# ===========================================
REQUIRE_INVITATION_CODE=false

# ===========================================
# Tenant Invitation
# ===========================================
INVITATION_TOKEN_EXPIRE_SECONDS=604800
FRONTEND_URL=http://localhost:3000

# ===========================================
# OAuth2 / SSO
# Get credentials from:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=

# ===========================================
# LLM Configuration (OpenAI-compatible)
# ===========================================
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Boilerplate
DEBUG=false

# ===========================================
# Server Configuration
# ===========================================
SERVER_HOST=localhost
SERVER_PORT=8000

# ===========================================
# Docker Image (used by CD pipeline)
# ===========================================
DOCKER_IMAGE=fastapi-boilerplate:latest
