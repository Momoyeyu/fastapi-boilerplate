# ===========================================
# FastAPI Boilerplate - Environment Variables
# ===========================================
# Copy this file to .env and update the values
# for your environment.

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fastapi-boilerplate

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===========================================
# Security Configuration
# IMPORTANT: Change these in production!
# ===========================================
PASSWORD_SALT=change-me-to-secure-random-string
JWT_SECRET=change-me-to-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800
VERIFICATION_CODE_EXPIRE_SECONDS=300

# ===========================================
# Email (Resend)
# ===========================================
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ===========================================
# Invitation Code
# ===========================================
REQUIRE_INVITATION_CODE=false

# ===========================================
# Application Settings
# ===========================================
DEBUG=false

# ===========================================
# Docker Image (used by CD pipeline)
# ===========================================
DOCKER_IMAGE=fastapi-boilerplate:latest
